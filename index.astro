</style>

<script>
  // 1. Web Audio Synthesizer Engine
  let audioCtx: AudioContext | null = null;
  let soundEnabled = false;

  function initAudio() {
    if (!audioCtx) {
      const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      audioCtx = new AudioClass();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playRelayClick() {
    if (!soundEnabled || !audioCtx) return;
    initAudio();
    const now = audioCtx.currentTime;

    // High noise snap
    const bufferSize = audioCtx.sampleRate * 0.02;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;

    const noise = audioCtx.createBufferSource();
    noise.buffer = buffer;
    const filter = audioCtx.createBiquadFilter();
    filter.type = 'highpass';
    filter.frequency.setValueAtTime(2400, now);
    const gain = audioCtx.createGain();
    gain.gain.setValueAtTime(0.25, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.018);

    noise.connect(filter);
    filter.connect(gain);
    gain.connect(audioCtx.destination);
    noise.start(now);

    // Low contact pulse
    const osc = audioCtx.createOscillator();
    const oscGain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(120, now);
    osc.frequency.exponentialRampToValueAtTime(30, now + 0.035);
    oscGain.gain.setValueAtTime(0.35, now);
    oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.035);

    osc.connect(oscGain);
    oscGain.connect(audioCtx.destination);
    osc.start(now);
  }

  function playGuitarNote() {
    if (!soundEnabled || !audioCtx) return;
    initAudio();
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const filter = audioCtx.createBiquadFilter();

    osc.type = 'triangle';
    osc.frequency.setValueAtTime(220, now); // A3

    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(1400, now);
    filter.frequency.exponentialRampToValueAtTime(220, now + 2.5);

    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.8);

    osc.connect(filter);
    filter.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start(now);
    osc.stop(now + 3.0);
  }

  // Audio Nav Toggle
  const navAudioToggle = document.getElementById('nav-audio-toggle');
  const audioLed = document.getElementById('audio-led');
  const audioLabel = document.getElementById('audio-label');

  navAudioToggle?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    if (soundEnabled) {
      initAudio();
      audioLed?.classList.add('active');
      if (audioLabel) audioLabel.textContent = 'SOUND: ACTIVE';
      playRelayClick();
    } else {
      audioLed?.classList.remove('active');
      if (audioLabel) audioLabel.textContent = 'SOUND: OFF';
    }
  });

  // 2. Cursor Tracking & Fade-up Observer
  const cursor = document.getElementById('cursor');
  window.addEventListener('mousemove', (e) => {
    if (cursor) {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    }
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

  // 3. Interactive Waveform Canvas & Analog VU Needle
  const canvas = document.getElementById('waveform-canvas') as HTMLCanvasElement | null;
  const canvasStatus = document.getElementById('canvas-status');
  const vuNeedle = document.getElementById('hero-vu-needle');
  let ctx: CanvasRenderingContext2D | null = null;
  let phase = 0;
  let decayTimer = 0;
  let isDecaying = false;

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx = canvas.getContext('2d');
    if (ctx) ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }

  function renderAudioGraph() {
    if (!canvas || !ctx) return;
    const w = canvas.width / window.devicePixelRatio;
    const h = canvas.height / window.devicePixelRatio;

    ctx.clearRect(0, 0, w, h);

    // Center baseline
    ctx.beginPath();
    ctx.strokeStyle = '#1c1f22';
    ctx.moveTo(0, h / 2);
    ctx.lineTo(w, h / 2);
    ctx.stroke();

    let ampEnvelope = Math.exp(-decayTimer * 1.4);
    if (!isDecaying) {
      ampEnvelope = 0.2 + Math.sin(phase * 0.6) * 0.05;
    } else {
      decayTimer += 0.016;
      if (decayTimer > 3.0) {
        isDecaying = false;
        decayTimer = 0;
        if (canvasStatus) canvasStatus.textContent = 'CLICK CANVAS TO TRIGGER GUITAR DECAY';
      }
    }

    ctx.beginPath();
    ctx.lineWidth = 1.6;
    ctx.strokeStyle = isDecaying ? '#d4a373' : '#8b8e94';

    for (let x = 0; x < w; x++) {
      const normX = x / w;
      const wave1 = Math.sin(normX * 28 + phase);
      const wave2 = Math.sin(normX * 56 + phase * 1.5) * 0.25;
      const y = h / 2 + (wave1 + wave2) * (h / 3.2) * ampEnvelope;
      if (x === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Realtime VU Needle Wobble
    if (vuNeedle) {
      const angle = -25 + ampEnvelope * 45 + Math.sin(phase) * 2.5;
      vuNeedle.style.transform = `rotate(${angle}deg)`;
    }

    phase += 0.07;
    requestAnimationFrame(renderAudioGraph);
  }

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
  renderAudioGraph();

  canvas?.addEventListener('click', () => {
    isDecaying = true;
    decayTimer = 0;
    if (canvasStatus) canvasStatus.textContent = 'SUSTAIN & DECAY ACTIVE (PHIL McGARRICK)';
    playGuitarNote();
  });

  // 4. Ritual Controls (Power Switch & CD Tray)
  const powerBtn = document.getElementById('power-switch-btn');
  const leverKnob = document.getElementById('lever-knob');
  const ritualLed = document.getElementById('ritual-led');
  const ritualStatus = document.getElementById('ritual-status');

  const ejectBtn = document.getElementById('eject-btn');
  const spinningCd = document.getElementById('spinning-cd');
  const trayStatus = document.getElementById('tray-status');

  let isAmpOn = false;
  let isCdLoaded = false;

  powerBtn?.addEventListener('click', () => {
    isAmpOn = !isAmpOn;
    playRelayClick();

    if (isAmpOn) {
      leverKnob?.classList.add('on');
      if (ritualLed) {
        ritualLed.style.background = '#d4a373';
        ritualLed.style.boxShadow = '0 0 10px #d4a373';
      }
      if (ritualStatus) {
        ritualStatus.textContent = 'CLASS-A ACTIVE';
        ritualStatus.style.color = '#d4a373';
      }
    } else {
      leverKnob?.classList.remove('on');
      if (ritualLed) {
        ritualLed.style.background = '#400';
        ritualLed.style.boxShadow = 'none';
      }
      if (ritualStatus) {
        ritualStatus.textContent = 'STANDBY';
        ritualStatus.style.color = 'var(--subtle)';
      }
    }
  });

  ejectBtn?.addEventListener('click', () => {
    isCdLoaded = !isCdLoaded;
    playRelayClick();

    if (isCdLoaded) {
      spinningCd?.classList.add('loaded');
      if (trayStatus) {
        trayStatus.textContent = 'TRAY OPEN / CD LOADED';
        trayStatus.style.color = '#d4a373';
      }
      playGuitarNote();
    } else {
      spinningCd?.classList.remove('loaded');
      if (trayStatus) {
        trayStatus.textContent = 'CLOSED';
        trayStatus.style.color = 'var(--subtle)';
      }
    }
  });

  // Enter Room Button Flash
  const enterBtn = document.getElementById('enter-btn');
  enterBtn?.addEventListener('click', () => {
    playRelayClick();
    document.body.style.opacity = '0.92';
    setTimeout(() => {
      document.body.style.opacity = '1';
    }, 120);
  });
</script>